  "403": {
    "https_required": {
      "http": {
        "error": "Sign-in needs HTTPS, or a browser on this computer. Open Uptime Goblin through its HTTPS address. GOBLIN_INSECURE_HTTP_SESSIONS=1 allows sign-in over plain HTTP, but the password and the sign-in cookie then cross the network unencrypted: set it only on a network you trust.",
        "code": "https_required"
      }
    },
    "proxy_proto_missing": {
      "http": {
        "error": "Your browser uses HTTPS, but the reverse proxy does not tell Uptime Goblin so. Make the proxy send X-Forwarded-Proto: https (nginx: proxy_set_header X-Forwarded-Proto $scheme;) and make sure GOBLIN_TRUST_PROXY names it, or set GOBLIN_INSECURE_HTTP_SESSIONS=1 until it is fixed.",
        "code": "proxy_proto_missing"
      }
    },
    "proxy_proto_mismatch": {
      "https": {
        "error": "Your browser uses plain HTTP (http://), but the reverse proxy tells Uptime Goblin the connection is HTTPS, so the browser would drop Uptime Goblin's secure sign-in cookie. Make the proxy send the real scheme (nginx: proxy_set_header X-Forwarded-Proto $scheme;), or open Uptime Goblin at its https:// address.",
        "code": "proxy_proto_mismatch"
      }
    },
    "cross_origin": {
      "https": {
        "error": "Cross-origin changes are not allowed",
        "code": "cross_origin"
      },
      "loopback": {
